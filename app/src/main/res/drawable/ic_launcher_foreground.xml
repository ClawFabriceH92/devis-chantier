<?xml version="1.0" encoding="utf-8"?>
<!-- Devis Chantier: a quote sheet, a check and a hammer. Own icon, own colours
     (deep blue + orange), nothing borrowed from another app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,22 L68,22 Q72,22 72,26 L72,82 Q72,86 68,86 L36,86 Q32,86 32,82 L32,26 Q32,22 36,22 Z" />

    <!-- folded corner -->
    <path
        android:fillColor="#D8E4EC"
        android:pathData="M60,22 L68,22 Q72,22 72,26 L72,34 Z" />

    <!-- text lines, getting shorter like a quote's totals -->
    <path
        android:fillColor="#9FB3C0"
        android:pathData="M39,32 h24 v3.4 h-24 z" />
    <path
        android:fillColor="#9FB3C0"
        android:pathData="M39,41 h27 v2.8 h-27 z" />
    <path
        android:fillColor="#9FB3C0"
        android:pathData="M39,48 h19 v2.8 h-19 z" />

    <!-- euro sign: the money the quote is about -->
    <path
        android:strokeColor="#E4761B"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M61,60 A8.5,8.5 0 1 0 61,75" />
    <path
        android:strokeColor="#E4761B"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M48,65 h11" />
    <path
        android:strokeColor="#E4761B"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M48,70 h11" />

    <!-- validation check: a quote that is sent -->
    <path
        android:strokeColor="#1B6B4A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M73,74 L79,80 L92,62" />
</vector>
